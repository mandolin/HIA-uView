{
  "plugins": [
    "node_modules/@mandolin/jsdoc-plugin-hia-sys/src/index.cjs"
  ],
  "source": {
    "include": [
      "scripts",
      "tests"
    ],
    "includePattern": ".+\\.(m?js)$",
    "excludePattern": "(^|\\\\|/)node_modules(\\\\|/)|(^|\\\\|/)temp(\\\\|/)"
  },
  "opts": {
    "encoding": "utf8",
    "template": "node_modules/@mandolin/jsdoc-theme-hia",
    "destination": "temp/documentation/jsdoc/reference",
    "recurse": true,
    "hia": {
      "mode": "hiaIntegration",
      "microPlugins": [
        "source-link",
        "source-preview",
        "doc-i18n",
        "doclet-normalizer",
        "hia-ir-exporter",
        "diagnostics"
      ],
      "source": {
        "basePath": ".",
        "mode": "metadata-only",
        "link": {
          "enabled": false,
          "rootUrl": "",
          "openMode": "same-tab"
        },
        "preview": {
          "enabled": false,
          "defaultExpanded": false
        },
        "references": {
          "enabled": false,
          "defaultExpanded": false
        }
      },
      "i18n": {
        "enabled": true,
        "defaultLocale": "zh-CN",
        "fallbackLocale": "en",
        "locales": [
          "zh-CN",
          "en"
        ],
        "mode": "runtimeSwitch",
        "resourceBasePath": ".",
        "resources": []
      },
      "integration": {
        "enabled": true,
        "outputFile": "temp/documentation/jsdoc/hia-integration.json"
      },
      "theme": {
        "skin": "classic",
        "languageControls": {
          "mode": "auto",
          "dropdownThreshold": 4
        },
        "code": {
          "controls": true,
          "fontFamily": "sarasa",
          "fontSize": 12,
          "lineHeight": 1.55,
          "tabSize": 2,
          "wrap": false
        }
      }
    }
  }
}
