{
  "name": "hia-uview-repo",
  "version": "0.0.0",
  "private": true,
  "description": "Repository orchestration package for HIA-uView.",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "HIA-uView-UI",
    "HIA-uView-Tool"
  ],
  "scripts": {
    "check": "node scripts/verify-workspace.mjs && npm run docs:check && npm run theme:check",
    "docs:api": "jsdoc -c docs/jsdoc.config.json",
    "docs:check": "node scripts/check-documentation.mjs && npm run docs:api && node scripts/verify-documentation-output.mjs",
    "test": "node --test tests/verify-package-contract.test.mjs tests/verify-documentation-contract.test.mjs tests/verify-theme-contract.test.mjs",
    "theme:check": "node scripts/check-theme.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mandolin/HIA-uView.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-app": "3.0.0-5010520260709002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5010520260709002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5010520260709002",
    "@mandolin/jsdoc-plugin-hia-sys": "0.1.2",
    "@mandolin/jsdoc-theme-hia": "0.1.1",
    "jsdoc": "4.0.5",
    "vite": "5.2.8",
    "vue": "3.4.21"
  }
}
